<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ArbSh.Terminal"
        x:Class="ArbSh.Terminal.MainWindow"
        Title="أربش"
        Icon="/Assets/Brand/ArbShIcon.ico"
        Width="1120"
        Height="640"
        MinWidth="520"
        MinHeight="320"
        Background="#0C0C0C"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        FontFamily="avares://ArbSh.Terminal/Assets/Fonts/Cairo.ttf#Cairo, Segoe UI, Tahoma">
  <!--
    نسخة معكوسة من Windows Terminal: شريط العنوان يحمل علامات التبويب من اليمين،
    وأزرار النافذة على اليسار كما في واجهة Windows العربية، وتحته الطرفية مباشرة.
  -->
  <Window.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chrome:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3D3D3D" />
    </Style>
    <Style Selector="Button.chrome:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#353535" />
    </Style>
    <Style Selector="Button.caption-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
    </Style>
    <Style Selector="Button.caption-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#B22A1B" />
    </Style>
    <Style Selector="Button.rounded">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Path.glyph">
      <Setter Property="Stroke" Value="#FFFFFF" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.tab">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.tab:pointerover">
      <Setter Property="Background" Value="#383838" />
    </Style>
    <Style Selector="Border.tab.selected">
      <Setter Property="Background" Value="#0C0C0C" />
    </Style>
    <Style Selector="Border.tab Button.tab-close">
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="FlowDirection" Value="RightToLeft" />
      <Setter Property="Background" Value="#2C2C2C" />
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid"
        RowDefinitions="40,*"
        Margin="{Binding $parent[Window].OffScreenMargin}">
    <Grid x:Name="TitleBar"
          Grid.Row="0"
          Background="#2E2E2E"
          FlowDirection="RightToLeft"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          PointerPressed="TitleBar_PointerPressed">
      <!-- درع المسؤول، كما يظهره Windows Terminal عند التشغيل بصلاحيات مرتفعة. -->
      <Panel x:Name="ShieldIcon"
             Grid.Column="0"
             Width="34"
             IsVisible="False">
        <Path Classes="glyph"
              Stroke="#A6A6A6"
              Data="M6,0 L12,2.2 L12,7 C12,10.6 9.4,13 6,14 C2.6,13 0,10.6 0,7 L0,2.2 Z" />
      </Panel>
      <Panel x:Name="ShieldSpacer" Grid.Column="0" Width="8" />

      <ItemsControl x:Name="TabStrip"
                    Grid.Column="1"
                    VerticalAlignment="Bottom">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:TerminalTab">
            <Border Classes="tab"
                    Classes.selected="{Binding IsSelected}"
                    Width="{Binding Width}"
                    Height="32"
                    CornerRadius="8,8,0,0"
                    ToolTip.Tip="{Binding Session.CurrentDirectory}"
                    PointerPressed="Tab_PointerPressed">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,4,0">
                <Image Grid.Column="0"
                       Width="16"
                       Height="16"
                       FlowDirection="LeftToRight"
                       Source="/Assets/Brand/ArbShIcon.png"
                       VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,6,1"
                           Text="{Binding Title}"
                           Foreground="#FFFFFF"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Classes="chrome rounded tab-close"
                        Width="28"
                        Height="24"
                        ToolTip.Tip="إغلاق علامة التبويب"
                        Click="CloseTabButton_Click">
                  <Path Classes="glyph" Data="M0,0 L8,8 M8,0 L0,8" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Grid.Column="2"
              Classes="chrome rounded"
              Width="40"
              Height="30"
              Margin="4,4,0,2"
              VerticalAlignment="Bottom"
              ToolTip.Tip="علامة تبويب جديدة (Ctrl+Shift+T)"
              Click="NewTabButton_Click">
        <Path Classes="glyph" Data="M5,0 L5,10 M0,5 L10,5" />
      </Button>

      <Button Grid.Column="3"
              Classes="chrome rounded"
              Width="32"
              Height="30"
              Margin="0,4,0,2"
              VerticalAlignment="Bottom"
              ToolTip.Tip="فتح قائمة">
        <Path Classes="glyph" Data="M0,0 L5,5 L10,0" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="علامة تبويب جديدة" InputGesture="Ctrl+Shift+T" Click="NewTabButton_Click" />
            <MenuItem Header="نافذة جديدة" InputGesture="Ctrl+Shift+N" Click="NewWindowMenuItem_Click" />
            <Separator />
            <MenuItem Header="إغلاق علامة التبويب" InputGesture="Ctrl+Shift+W" Click="CloseCurrentTabMenuItem_Click" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>

      <StackPanel Grid.Column="5"
                  Orientation="Horizontal"
                  VerticalAlignment="Top">
        <Button Classes="chrome"
                Width="46"
                Height="40"
                ToolTip.Tip="تصغير"
                Click="MinimizeButton_Click">
          <Path Classes="glyph" Data="M0,0 L10,0" />
        </Button>
        <Button Classes="chrome"
                Width="46"
                Height="40"
                ToolTip.Tip="تكبير"
                Click="MaximizeButton_Click">
          <Panel>
            <Path x:Name="MaximizeGlyph" Classes="glyph" Data="M0,0 L10,0 L10,10 L0,10 Z" />
            <Path x:Name="RestoreGlyph"
                  Classes="glyph"
                  IsVisible="False"
                  Data="M0,2 L8,2 L8,10 L0,10 Z M2,2 L2,0 L10,0 L10,8 L8,8" />
          </Panel>
        </Button>
        <Button Classes="chrome caption-close"
                Width="46"
                Height="40"
                ToolTip.Tip="إغلاق"
                Click="CloseWindowButton_Click">
          <Path Classes="glyph" Data="M0,0 L10,10 M10,0 L0,10" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- يرسم السطح اتجاه كل سطر بنفسه، فيبقى خارج قلب الاتجاه الذي يطبقه شريط العنوان. -->
    <Panel x:Name="SurfaceHost"
           Grid.Row="1"
           FlowDirection="LeftToRight"
           Background="#0C0C0C" />
  </Grid>
</Window>
